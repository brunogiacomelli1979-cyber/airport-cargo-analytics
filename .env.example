# Configure estes valores em Railway > serviço web > Variables; nunca envie segredos ao GitHub.
# Crie um PostgreSQL no mesmo projeto e adicione no serviço web:
DATABASE_URL=${{Postgres.DATABASE_URL}}
ACCESS_CODE=troque-por-um-codigo-operacional-forte
SESSION_SECRET=troque-por-uma-string-aleatoria-com-mais-de-32-caracteres
COOKIE_SECURE=1
PRODUCTION=1
