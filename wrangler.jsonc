{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "controle-paletes-aeronauticos",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paletes-producao",
      "database_id": "1bc139d5-6d9a-4e93-9b83-511099dd3753"
    }
  ]
}
